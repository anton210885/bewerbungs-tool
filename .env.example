# Land für Stellensuche und Schreibstil: ch = Schweiz, de = Deutschland
COUNTRY=ch

# KI-Anbieter (OpenAI-kompatibel). Standard: Venice
LLM_API_KEY=
LLM_BASE_URL=https://api.venice.ai/api/v1
LLM_MODEL=claude-sonnet-5-5
# Optional: eigenes Modell zum Lesen von Scans/Fotos (muss "Vision" können)
LLM_VISION_MODEL=

# Für OpenAI stattdessen:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Adzuna (kostenlos registrieren: https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
